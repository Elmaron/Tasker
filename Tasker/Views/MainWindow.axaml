<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tasker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Tasker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Tasker">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
	
    <DockPanel Name="dockpanel_main"
			   Background="{Binding ColorBackground4}">
        <StackPanel DockPanel.Dock="Top"
			Background="{Binding ColorSecondary3}"
			Orientation="Horizontal">
            <!--<Button>Settings</Button>-->
			<Button
				Background="{Binding ColorSecondary2}"
				>Start/Stop</Button>
			<ComboBox
				Background="{Binding ColorSecondary1}"
				ItemsSource="{Binding Categories}"
				SelectedItem="{Binding SelectedCategory}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock 
							Text="{Binding Data.Label}">
							<TextBlock.ContextMenu>
								<ContextMenu
									Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorSecondary2}">
									<MenuItem
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"/>
								</ContextMenu>
							</TextBlock.ContextMenu>
						</TextBlock>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<TextBox 
				Background="{Binding ColorSecondary2}"
				PlaceholderText="{Binding NewCategoryPlaceholder}"
				Text="{Binding NewCategoryName}"
				MaxLength="30"/>
			<Button
				Background="{Binding ColorSecondary2}"
				Command="{Binding CreateCategory}">+</Button>
        </StackPanel>
        <DockPanel 
			Name="dockpanel_projects"
            DockPanel.Dock="Left"
            Background="{Binding ColorPrimary4}"
			MinWidth="200">
            <TextBlock 
				Text="Projects"
                Background="{Binding ColorPrimary3}"
                DockPanel.Dock="Top" />
            <Grid 
				ColumnDefinitions="Auto, *" RowDefinitions="Auto"
				DockPanel.Dock="Bottom"
                Background="{Binding ColorPrimary3}">
                <TextBox 
					Grid.Column="1" Grid.Row="0"
					Background="{Binding ColorPrimary2}"
					PlaceholderText="{Binding NewProjectPlaceholder}"
					Text="{Binding NewProjectName}"
					MaxLength="30" />
                <Button 
					Grid.Column="0" Grid.Row="0"
					Background="{Binding ColorPrimary2}"
					Command="{Binding CreateProject}">+</Button>
            </Grid>
			<ListBox 
				Background="{Binding ColorPrimary2}"
				ItemsSource="{Binding Projects}"
				SelectedItem="{Binding SelectedProject}">
				<ListBox.Styles>
					<Style
						Selector="ListBoxItem:selected /template/ ContentPresenter">
						<Setter Property="Background" Value="{Binding ColorPrimary0}"/>						
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Data.Label}">
							<TextBlock.ContextMenu>
								<ContextMenu
									Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorPrimary2}">
									<MenuItem 
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"/>
								</ContextMenu>
							</TextBlock.ContextMenu>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <DockPanel 
			Name="dockpanel_details"
            DockPanel.Dock="Right"
            Background="{Binding ColorPrimary4}"
			MinWidth="300"
			IsVisible="False">
            <TextBlock 
				Text="Details"
                Background="{Binding ColorPrimary3}"
                DockPanel.Dock="Top"></TextBlock>
            <Button
				DockPanel.Dock="Bottom"
                Background="{Binding ColorPrimary3}">edit</Button>
		    <StackPanel
				Orientation="Vertical"
				Background="{Binding ColorPrimary3}">
            </StackPanel>
        </DockPanel>
        <DockPanel Name="dockpanel_tasks"
            Background="{Binding ColorBackground4}">
            <Grid 
				ColumnDefinitions="Auto, *" RowDefinitions="Auto"
				DockPanel.Dock="Bottom"
                Background="{Binding ColorBackground3}">
                <TextBox 
					Grid.Column="1" Grid.Row="0" 
					PlaceholderText="{Binding NewTaskPlaceholder}"
					Text="{Binding NewTaskName}"
					Background="{Binding ColorBackground2}"
					MaxLength="30"></TextBox>
                <Button 
					Grid.Column="0" Grid.Row="0"
					Background="{Binding ColorBackground2}"
					Command="{Binding SelectedProject.CreateTask}"
					CommandParameter="{Binding NewTaskName}">+</Button>
            </Grid>
			<TableView ItemsSource="{Binding Tasks}"
					  Background ="hsla(0,0,0%, 0)">
				<TableView.Columns>
					<TableViewColumn Header="✅" Width="40">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<CheckBox IsChecked="{Binding Data.IsFinished}"/>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Label" Width="*">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="Auto,*">
									<Button
										Grid.Column="0"
										IsVisible="{Binding Data.IsFinishedInversed}"
										Content="Start/Stop"/>
									<TextBox
										Grid.Column="1"
										Text="{Binding Data.Label}"/>
								</Grid>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Difficulty" Width="Auto">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<ComboBox
								Grid.Column="3"
								ItemsSource="{Binding AvailableDifficulties}"
								SelectedItem="{Binding SelectedDifficulty}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<Border
												Background="{Binding Color}"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Margin="-12,-4"
												Padding="12,4">
												<TextBlock
													VerticalAlignment="Center"
													Text="{Binding Label}"
													ToolTip.Tip="{Binding Hint}"/>
											</Border>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Priority" Width="Auto">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<ComboBox
								Grid.Column="4"
								ItemsSource="{Binding AvailablePriorities}"
								SelectedItem="{Binding SelectedPriority}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<Border
												Background="{Binding Color}"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Margin="-12,-4"
												Padding="12,4">
												<TextBlock
													VerticalAlignment="Center"
													Text="{Binding Label}"/>
											</Border>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="" Width="Auto">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<Button
								Grid.Column="6"
								Content="Details"
								Command=""
								CommandParameter=""
									/>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
							
							<!--
							<Button Content="Delete"
									Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTask}"
									CommandParameter="{Binding Id}"
									/>
									-->
							<!--
							<Grid.ContextMenu>
								<ContextMenu>
									<MenuItem 
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"
										Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTask}"
										CommandParameter="{Binding Id}"/>
								</ContextMenu>
							</Grid.ContextMenu>
							-->
				</TableView.Columns>
			</TableView>
        </DockPanel>
    </DockPanel>



</Window>
