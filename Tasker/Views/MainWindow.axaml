<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tasker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Tasker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Tasker">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
	
    <DockPanel
		Background="{Binding ColorBackground4}">
		<!--Top Bar-->
        <StackPanel DockPanel.Dock="Top"
			Background="{Binding ColorSecondary3}"
			Orientation="Horizontal">
			<Button
				Background="{Binding ColorSecondary2}"
				Content="Start/Stop" />
			<ComboBox
				Background="{Binding ColorSecondary1}"
				ItemsSource="{Binding Categories}"
				SelectedItem="{Binding SelectedCategory}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock 
							Text="{Binding Data.Label}">
							<TextBlock.ContextMenu>
								<ContextMenu
									Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorSecondary2}">
									<MenuItem
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"
										Command="{Binding DeleteCategory}"/>
								</ContextMenu>
							</TextBlock.ContextMenu>
						</TextBlock>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<TextBox 
				Background="{Binding ColorSecondary2}"
				PlaceholderText="{Binding NewCategoryPlaceholder}"
				Text="{Binding NewCategoryName}"
				MaxLength="30"/>
			<Button
				Background="{Binding ColorSecondary2}"
				Command="{Binding CreateCategory}"
				Content="+"/>
        </StackPanel>
		<!--Projects on the left side-->
        <DockPanel
            DockPanel.Dock="Left"
            Background="{Binding ColorPrimary4}"
			MinWidth="200">
            <TextBlock
				Text="Projects"
                Background="{Binding ColorPrimary3}"
                DockPanel.Dock="Top"/>
            <Grid 
				ColumnDefinitions="Auto, *" RowDefinitions="Auto"
				DockPanel.Dock="Bottom"
                Background="{Binding ColorPrimary3}">
                <TextBox 
					Grid.Column="1" Grid.Row="0"
					Background="{Binding ColorPrimary2}"
					PlaceholderText="{Binding NewProjectPlaceholder}"
					Text="{Binding NewProjectName}"
					MaxLength="30"/>
                <Button 
					Grid.Column="0" Grid.Row="0"
					Background="{Binding ColorPrimary2}"
					Command="{Binding CreateProject}"
					Content="+"/>
            </Grid>
			<ListBox 
				Background="{Binding ColorPrimary2}"
				ItemsSource="{Binding Projects}"
				SelectedItem="{Binding SelectedProject}">
				<ListBox.Styles>
					<Style
						Selector="ListBoxItem:selected /template/ ContentPresenter">
						<Setter Property="Background" Value="{Binding ColorPrimary0}"/>						
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Data.Label}">
							<TextBlock.ContextMenu>
								<ContextMenu
									Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorPrimary2}">
									<MenuItem 
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"/>
								</ContextMenu>
							</TextBlock.ContextMenu>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
		<!--Details on the right-->
									<!--For Task Details-->
        <DockPanel 
            DockPanel.Dock="Right"
            Background="{Binding ColorPrimary4}"
			MinWidth="300"
			MaxWidth="400"
			IsVisible="{Binding IsTaskSelected}">
			<Grid
				DockPanel.Dock="Top">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"></ColumnDefinition>
					<ColumnDefinition Width="*"></ColumnDefinition>
					<ColumnDefinition Width="Auto"></ColumnDefinition>
					<ColumnDefinition Width="Auto"></ColumnDefinition>
				</Grid.ColumnDefinitions>
				<CheckBox
					Grid.Column="0"
					IsChecked="{Binding SelectedTask.Data.IsFinished}"/>
				<TextBox
					Text="{Binding SelectedTask.Data.Label}"
					Grid.Column="1"
					Background="{Binding ColorPrimary3}"/>
				<TextBlock
					Grid.Column="2"
					Text="{Binding SelectedTask.Id}"/>
				<Button 
					Content="Close"
					Grid.Column="3"
					Command="{Binding ButtonCommand_DetailedViewCloseButton}"/>
			</Grid>
            <Button
				DockPanel.Dock="Bottom"
                Background="{Binding ColorPrimary3}">edit Timings (not implemented)</Button>
			<ScrollViewer
				VerticalScrollBarVisibility="Hidden"
				HorizontalScrollBarVisibility="Disabled">
				<Grid
					Background="{Binding ColorPrimary3}"
					RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBox
						Text="{Binding SelectedTask.Data.Description}"
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="Priority"
						Grid.Row="1"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<ComboBox
						Grid.Column="1"
						Grid.Row="1"
						ItemsSource="{Binding SelectedTask.AvailablePriorities}"
						SelectedItem="{Binding SelectedTask.SelectedPriority}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<Border
									Background="{Binding Color}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Margin="-12,-4"
									Padding="12,4">
									<TextBlock
										VerticalAlignment="Center"
										Text="{Binding Label}"/>
								</Border>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<TextBlock
						Text="Difficulty"
						Grid.Row="2"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<ComboBox
						Grid.Column="1"
						Grid.Row="2"
						ItemsSource="{Binding SelectedTask.AvailableDifficulties}"
						SelectedItem="{Binding SelectedTask.SelectedDifficulty}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<Border
									Background="{Binding Color}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Margin="-12,-4"
									Padding="12,4">
									<TextBlock
										VerticalAlignment="Center"
										Text="{Binding Label}"/>
								</Border>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<TextBlock
						Text="Created"
						Grid.Row="3"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.Created}"
						Grid.Row="3"
						Grid.Column="1"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="Last Update"
						Grid.Row="4"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.Updated}"
						Grid.Row="4"
						Grid.Column="1"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="expires on"
						Grid.Row="5"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/> <!--Difference between delete on and expiry -> delete on is the date, when the task is deleted from the database.
						Expiry is the day/time, until the task needs to be finished.-->
					<TextBlock
						Text="{Binding SelectedTask.Expiry}"
						Grid.Row="5"
						Grid.Column="1"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="Finished"
						Grid.Row="6"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.Finished}"
						Grid.Row="6"
						Grid.Column="1"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="Delete Task on"
						Grid.Row="7"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.DeleteOn}"
						Grid.Row="7"
						Grid.Column="1"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="Worked on Task"
						Grid.Row="8"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Background="{Binding ColorPrimary2}"/>
					<TableView
						Grid.Row="9"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						ItemsSource="{Binding SelectedTask.Worktimes}"
						Background="hsla(0,0%,0%,0)">
						<TableView.Columns>
							<TableViewColumn Header="Start" Width="*">
								<TableViewColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Start}"/>
									</DataTemplate>
								</TableViewColumn.CellTemplate>
							</TableViewColumn>
							<TableViewColumn Header="End" Width="*">
								<TableViewColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding End}"/>
									</DataTemplate>
								</TableViewColumn.CellTemplate>
							</TableViewColumn>
						</TableView.Columns>
					</TableView>
				</Grid>
			</ScrollViewer>
        </DockPanel>
		<!--Main View for Tasks and Appointments-->
        <DockPanel
            Background="{Binding ColorBackground4}">
            <Grid 
				ColumnDefinitions="Auto, *" RowDefinitions="Auto"
				DockPanel.Dock="Bottom"
                Background="{Binding ColorBackground3}">
                <TextBox 
					Grid.Column="1" Grid.Row="0" 
					PlaceholderText="{Binding NewTaskPlaceholder}"
					Text="{Binding NewTaskName}"
					Background="{Binding ColorBackground2}"
					MaxLength="30"></TextBox>
                <Button 
					Grid.Column="0" Grid.Row="0"
					Background="{Binding ColorBackground2}"
					Command="{Binding SelectedProject.CreateTask}"
					CommandParameter="{Binding NewTaskName}">+</Button>
            </Grid>
			<TableView 
				ItemsSource="{Binding Tasks}"
				SelectedItem="{Binding SelectedTask}"
				Background ="hsla(0,0,0%, 0)">
				<TableView.Columns>
					<TableViewColumn Header="✅" Width="40">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<CheckBox 
									IsChecked="{Binding Data.IsFinished}"/>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Label" Width="*">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="Auto,*">
									<Button
										Grid.Column="0"
										IsVisible="{Binding Data.IsFinishedInversed}"
										Content="{Binding ButtonText_StartStopButton}"
										Command="{Binding ButtonCommand_StartStopFunction}"/>
									<TextBox
										Grid.Column="1"
										Text="{Binding Data.Label}"/>
								</Grid>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Difficulty" Width="Auto">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<ComboBox
								Grid.Column="3"
								ItemsSource="{Binding AvailableDifficulties}"
								SelectedItem="{Binding SelectedDifficulty}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<Border
												Background="{Binding Color}"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Margin="-12,-4"
												Padding="12,4">
												<TextBlock
													VerticalAlignment="Center"
													Text="{Binding Label}"
													ToolTip.Tip="{Binding Hint}"/>
											</Border>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Priority" Width="Auto">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<ComboBox
								Grid.Column="4"
								ItemsSource="{Binding AvailablePriorities}"
								SelectedItem="{Binding SelectedPriority}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<Border
												Background="{Binding Color}"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Margin="-12,-4"
												Padding="12,4">
												<TextBlock
													VerticalAlignment="Center"
													Text="{Binding Label}"/>
											</Border>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>
					<TableViewColumn Header="Duration" Width="Auto">
						<TableViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock
									Text="{Binding DurationString}"/>
							</DataTemplate>
						</TableViewColumn.CellTemplate>
					</TableViewColumn>

					<!--
							<Button Content="Delete"
									Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTask}"
									CommandParameter="{Binding Id}"
									/>
									-->
					<!--
							<Grid.ContextMenu>
								<ContextMenu>
									<MenuItem 
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"
										Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTask}"
										CommandParameter="{Binding Id}"/>
								</ContextMenu>
							</Grid.ContextMenu>
							-->
				</TableView.Columns>
			</TableView>
        </DockPanel>
    </DockPanel>



</Window>
