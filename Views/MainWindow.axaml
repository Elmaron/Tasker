<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tasker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Tasker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Tasker.ico"
        Title="Tasker">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
	
    <DockPanel
		Background="{Binding ColorBackground4}">
		<!--Top Bar-->
        <Grid 
			DockPanel.Dock="Top"
			Background="{Binding ColorSecondary3}"
			RowDefinitions="Auto">
			<!--
			<Button
				Background="{Binding ColorSecondary2}"
				Content="Start/Stop" />-->
			<Grid.ColumnDefinitions>
				<ColumnDefinition MinWidth="200" Width="200" MaxWidth="400"/>
				<ColumnDefinition Width="200"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<ComboBox
				Grid.Row="0"
				Grid.Column="0"
				HorizontalAlignment="Stretch"
				Background="{Binding ColorSecondary1}"
				ItemsSource="{Binding Categories}"
				SelectedItem="{Binding SelectedCategory}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock 
							Text="{Binding Data.Label}">
							<TextBlock.ContextMenu>
								<ContextMenu
									Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorSecondary2}">
									<MenuItem
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"
										Command="{Binding DeleteCategory}"/>
								</ContextMenu>
							</TextBlock.ContextMenu>
						</TextBlock>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<TextBox 
				Grid.Row="0"
				Grid.Column="1"
				Background="{Binding ColorSecondary2}"
				PlaceholderText="{Binding NewCategoryPlaceholder}"
				Text="{Binding NewCategoryName}"
				MaxLength="30"/>
			<Button
				Grid.Row="0"
				Grid.Column="2"
				Background="{Binding ColorSecondary2}"
				Command="{Binding CreateCategory}"
				Content="+"/>
			<Button
				Grid.Row="0"
				Grid.Column="4"
				Content="Update App"
				Background="{Binding ColorSecondary1}"
				Command="{Binding UpdateAvaloniaApp}" />
        </Grid>
		<!--Projects on the left side-->
        <DockPanel
            DockPanel.Dock="Left"
            Background="{Binding ColorPrimary3}"
			MinWidth="200"
			MaxWidth="400">
            <TextBlock
				Text="Projects"
                Background="{Binding ColorPrimary2}"
                DockPanel.Dock="Top"/>
            <Grid 
				ColumnDefinitions="Auto, *" RowDefinitions="Auto"
				DockPanel.Dock="Bottom"
                Background="{Binding ColorPrimary2}">
                <TextBox 
					Grid.Column="1" Grid.Row="0"
					Background="{Binding ColorPrimary2}"
					PlaceholderText="{Binding NewProjectPlaceholder}"
					Text="{Binding NewProjectName}"
					MaxLength="30"/>
                <Button 
					Grid.Column="0" Grid.Row="0"
					Background="{Binding ColorPrimary2}"
					Command="{Binding CreateProject}"
					Content="+"/>
            </Grid>
			<ListBox 
				Background="{Binding ColorPrimary3}"
				ItemsSource="{Binding Projects}"
				SelectedItem="{Binding SelectedProject}">
				<ListBox.Styles>
					<Style
						Selector="ListBoxItem:selected /template/ ContentPresenter">
						<Setter Property="Background" Value="{Binding ColorPrimary0}"/>						
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Data.Label}">
							<TextBlock.ContextMenu>
								<ContextMenu
									Background="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorPrimary2}">
									<MenuItem 
										Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteButtonText}"/>
								</ContextMenu>
							</TextBlock.ContextMenu>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
		<!--Details on the right-->
									<!--For Task Details-->
        <DockPanel 
            DockPanel.Dock="Right"
            Background="{Binding ColorPrimary2}"
			MinWidth="300"
			MaxWidth="400"
			IsVisible="{Binding IsTaskSelected}">
			<Grid
				DockPanel.Dock="Top"
				Background="{Binding ColorPrimary2}"
				Margin="8,0">
				<Grid.Styles>
					<Style Selector="TextBlock">
						<Setter Property="Padding" Value="8"/>
					</Style>
				</Grid.Styles>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"></ColumnDefinition>
					<ColumnDefinition Width="*"></ColumnDefinition>
					<ColumnDefinition Width="Auto"></ColumnDefinition>
					<ColumnDefinition Width="Auto"></ColumnDefinition>
				</Grid.ColumnDefinitions>
				<CheckBox
					Grid.Column="0"
					IsChecked="{Binding SelectedTask.Data.IsFinished}"
					Background="{Binding ColorPrimary2}"/>
				<TextBox
					Text="{Binding SelectedTask.Data.Label}"
					Grid.Column="1"
					Background="{Binding ColorPrimary2}"/>
				<TextBlock
					Grid.Column="2"
					Text="{Binding SelectedTask.Id}"
					Background="{Binding ColorPrimary2}"/>
				<Button 
					Content="Close"
					Grid.Column="3"
					Command="{Binding ButtonCommand_DetailedViewCloseButton}"
					Background="{Binding ColorPrimary2}"/>
			</Grid>
            <Button
				DockPanel.Dock="Bottom"
                Background="{Binding ColorPrimary2}">edit Timings (not implemented)</Button>
			<ScrollViewer
				VerticalScrollBarVisibility="Hidden"
				HorizontalScrollBarVisibility="Disabled">
				<Grid
					Background="{Binding ColorPrimary4}"
					RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
					<Grid.Styles>
						<Style Selector="TextBox">
							<Setter Property="Padding" Value="8"/>
						</Style>
						<Style Selector="TextBlock">
							<Setter Property="Padding" Value="8"/>
						</Style>
						<Style Selector="ComboBox">
							<Setter Property="Padding" Value="8"/>
						</Style>
						<Style Selector="TableView.Columns">
							<Style Selector="^:TextBox">
								<Setter Property="Padding" Value="0"/>
							</Style>
							<Style Selector="^:TextBlock">
								<Setter Property="Padding" Value="0"/>
							</Style>
						</Style>
					</Grid.Styles>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox
						Text="{Binding SelectedTask.Data.Description}"
						PlaceholderText="Put your description here..."
						AcceptsReturn="True"
						MinLines="3"
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="Priority"
						Grid.Row="1"
						Grid.Column="0"
						Background="{Binding ColorPrimary3}"/>
					<ComboBox
						Grid.Column="1"
						Grid.Row="1"
						HorizontalAlignment="Stretch"
						ItemsSource="{Binding SelectedTask.AvailablePriorities}"
						SelectedItem="{Binding SelectedTask.SelectedPriority}"
						Background="{Binding ColorPrimary4}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<Border
									Background="{Binding Color}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Margin="-12,-4"
									Padding="12,4">
									<TextBlock
										VerticalAlignment="Center"
										Text="{Binding Label}"/>
								</Border>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<TextBlock
						Text="Difficulty"
						Grid.Row="2"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<ComboBox
						Grid.Column="1"
						Grid.Row="2"
						HorizontalAlignment="Stretch"
						ItemsSource="{Binding SelectedTask.AvailableDifficulties}"
						SelectedItem="{Binding SelectedTask.SelectedDifficulty}"
						Background="{Binding ColorPrimary3}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<Border
									Background="{Binding Color}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Margin="-12,-4"
									Padding="12,4">
									<TextBlock
										VerticalAlignment="Center"
										Text="{Binding Label}"/>
								</Border>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<TextBlock
						Text="Created"
						Grid.Row="3"
						Grid.Column="0"
						Background="{Binding ColorPrimary3}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.Created}"
						Grid.Row="3"
						Grid.Column="1"
						Background="{Binding ColorPrimary4}"/>
					<TextBlock
						Text="Last Update"
						Grid.Row="4"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.Updated}"
						Grid.Row="4"
						Grid.Column="1"
						Background="{Binding ColorPrimary3}"/>
					<TextBlock
						Text="expires on"
						Grid.Row="5"
						Grid.Column="0"
						Background="{Binding ColorPrimary3}"/> <!--Difference between delete on and expiry -> delete on is the date, when the task is deleted from the database.
						Expiry is the day/time, until the task needs to be finished.-->
					<TextBlock
						Text="{Binding SelectedTask.Expiry}"
						Grid.Row="5"
						Grid.Column="1"
						Background="{Binding ColorPrimary4}"/>
					<TextBlock
						Text="Finished"
						Grid.Row="6"
						Grid.Column="0"
						Background="{Binding ColorPrimary2}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.Finished}"
						Grid.Row="6"
						Grid.Column="1"
						Background="{Binding ColorPrimary3}"/>
					<TextBlock
						Text="Delete Task on"
						Grid.Row="7"
						Grid.Column="0"
						Background="{Binding ColorPrimary3}"/>
					<TextBlock
						Text="{Binding SelectedTask.Data.DeleteOn}"
						Grid.Row="7"
						Grid.Column="1"
						Background="{Binding ColorPrimary4}"/>
					<TextBlock
						Text="Worked on Task"
						Grid.Row="8"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Background="{Binding ColorPrimary2}"
						TextAlignment="Center"/>
					<TableView
						Grid.Row="9"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						ItemsSource="{Binding SelectedTask.Worktimes}"
						Background="hsla(0,0%,0%,0)"
						MaxWidth="330">
						<TableView.Columns>
							<TableViewColumn Header="Start" Width="*">
								<TableViewColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Start}"/>
									</DataTemplate>
								</TableViewColumn.CellTemplate>
							</TableViewColumn>
							<TableViewColumn Header="End" Width="*">
								<TableViewColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding End}"/>
									</DataTemplate>
								</TableViewColumn.CellTemplate>
							</TableViewColumn>
						</TableView.Columns>
					</TableView>
				</Grid>
			</ScrollViewer>
        </DockPanel>
		<!--Main View for Tasks and Appointments-->
		<DockPanel
            Background="{Binding ColorBackground4}">
			<Grid
				ColumnDefinitions="Auto, *" RowDefinitions="Auto"
				DockPanel.Dock="Bottom"
                Background="{Binding ColorBackground2}">
				<TextBox
					Grid.Column="1" Grid.Row="0"
					PlaceholderText="{Binding NewTaskPlaceholder}"
					Text="{Binding NewTaskName}"
					Background="{Binding ColorBackground2}"
					MaxLength="30"></TextBox>
				<Button
					Grid.Column="0" Grid.Row="0"
					Background="{Binding ColorBackground2}"
					Command="{Binding SelectedProject.CreateTask}"
					CommandParameter="{Binding NewTaskName}">+</Button>
			</Grid>
			<ScrollViewer>
				<StackPanel
					Grid.IsSharedSizeScope="True">
					<StackPanel.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						</Style>
					</StackPanel.Styles>
					<Grid
						RowDefinitions="Auto"
						ColumnSpacing="24"
						Margin="16, 8"
						Background="{Binding ColorBackground4}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition SharedSizeGroup="Finished"/>
							<ColumnDefinition SharedSizeGroup="StartStopButton"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition SharedSizeGroup="Priority"/>
							<ColumnDefinition SharedSizeGroup="Difficulty"/>
							<ColumnDefinition SharedSizeGroup="Duration"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="✅"/>
						<TextBlock Grid.Column="2" Text="Task"/>
						<TextBlock Grid.Column="3" Text="Priority"/>
						<TextBlock Grid.Column="4" Text="Difficulty"/>
						<TextBlock Grid.Column="5" Text="Duration"/>
					</Grid>
					<ListBox
						ItemsSource="{Binding Tasks}"
						SelectedItem="{Binding SelectedTask}"
						SelectionMode="Toggle">
						<ListBox.ItemTemplate>
							<DataTemplate>

								<Grid
									HorizontalAlignment="Stretch"
									ColumnSpacing="24"
									RowDefinitions="Auto"
									Margin="16, 8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition SharedSizeGroup="Finished"/>
										<ColumnDefinition SharedSizeGroup="StartStopButton"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition SharedSizeGroup="Priority"/>
										<ColumnDefinition SharedSizeGroup="Difficulty"/>
										<ColumnDefinition SharedSizeGroup="Duration"/>
									</Grid.ColumnDefinitions>
									<CheckBox Grid.Column="0" IsChecked="{Binding Data.IsFinished}"/>
									<Button Grid.Column="1"
											HorizontalAlignment="Stretch"
											IsVisible="{Binding Data.IsFinishedInversed}"
											Content="{Binding ButtonText_StartStopButton}"
											Command="{Binding ButtonCommand_StartStopFunction}"/>
									<TextBox Grid.Column="2" Text="{Binding Data.Label}"/>
									<ComboBox
									Grid.Column="3"
									HorizontalAlignment="Stretch"
									ItemsSource="{Binding AvailablePriorities}"
									SelectedItem="{Binding SelectedPriority}">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<Border
													Background="{Binding Color}"
													HorizontalAlignment="Stretch"
													VerticalAlignment="Stretch"
													Margin="-12,-4"
													Padding="12,4">
													<TextBlock
														VerticalAlignment="Center"
														Text="{Binding Label}"/>
												</Border>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<ComboBox
									Grid.Column="4"
									HorizontalAlignment="Stretch"
									ItemsSource="{Binding AvailableDifficulties}"
									SelectedItem="{Binding SelectedDifficulty}">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<Border
													Background="{Binding Color}"
													HorizontalAlignment="Stretch"
													VerticalAlignment="Stretch"
													Margin="-12,-4"
													Padding="12,4">
													<TextBlock
														VerticalAlignment="Center"
														Text="{Binding Label}"
														ToolTip.Tip="{Binding Hint}"/>
												</Border>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<TextBlock Grid.Column="5" Text="{Binding DurationString}"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>
    </DockPanel>



</Window>
