<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<!-- Farben -->
		<SolidColorBrush x:Key="MainBackground" Color="#1E1E1E"/>
		<SolidColorBrush x:Key="MainForeground" Color="White"/>
	</Styles.Resources>

	<!-- Style -->
	<Style Selector="Window">
		<Setter Property="Background" Value="{StaticResource MainBackground}"/>
		<Setter Property="Foreground" Value="{StaticResource MainForeground}"/>
	</Style>
</Styles>